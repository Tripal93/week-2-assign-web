<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Budget Tracker</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <header id="main-header">
        <div class="header-content">
            <img src="https://via.placeholder.com/50" alt="Budget Tracker Logo" width="50" class="logo">
            <h1>My Budget Tracker</h1>
        </div>
        <p class="subtitle">Track your income and expenses in one place.</p>
    </header>

    <main>
        <!-- Upgraded Add Expense Form -->
        <section id="add-expense-section" class="card">
            <h2>Add Expense</h2>
            <form>
                <div class="input-group">
                    <label for="expense-name">Expense Name</label>
                    <input type="text" id="expense-name" placeholder="e.g., Groceries">
                </div>
                <div class="input-group">
                    <label for="expense-amount">Amount ($)</label>
                    <input type="number" id="expense-amount" placeholder="0.00">
                </div>
                <div class="input-group">
                    <label for="expense-category">Category</label>
                    <select id="expense-category">
                        <option value="food">Food</option>
                        <option value="transport">Transport</option>
                        <option value="rent">Rent</option>
                        <option value="entertainment">Entertainment</option>
                        <option value="other">Other</option>
                    </select>
                </div>
                <button type="button" class="btn">Add Expense</button>
            </form>
        </section>

        <!-- Interactive Element -->
        <section class="card">
            <details>
                <summary>How to use this tracker</summary>
                <p>Fill out the expense name, amount, and choose a category from the dropdown above, then click 'Add Expense' to log it into your history.</p>
            </details>
        </section>

        <!-- Expense Table -->
        <section id="expenses-list-section" class="card expenses-section">
            <h2>Your Expenses</h2>
            <table class="expense-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Amount</th>
                        <th>Category</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Groceries</td>
                        <td>$45.50</td>
                        <td>Food</td>
                        <td>2026-10-01</td>
                    </tr>
                    <tr>
                        <td>Bus Pass</td>
                        <td>$30.00</td>
                        <td>Transport</td>
                        <td>2026-10-02</td>
                    </tr>
                    <tr>
                        <td>Apartment Rent</td>
                        <td>$850.00</td>
                        <td>Rent</td>
                        <td>2026-10-01</td>
                    </tr>
                    <tr>
                        <td>Movie Ticket</td>
                        <td>$15.00</td>
                        <td>Entertainment</td>
                        <td>2026-10-02</td>
                    </tr>
                    <tr>
                        <td>Coffee</td>
                        <td>$4.50</td>
                        <td>Food</td>
                        <td>2026-10-02</td>
                    </tr>
                </tbody>
            </table>
        </section>

        <!-- Multimedia (YouTube Video Embed) -->
        <section class="card video-section">
            <h2>Budgeting Tips</h2>
            <iframe width="100%" height="315" src="https://www.youtube.com/embed/dQw4w9WgXcQ" title="Budgeting Tips Video" frameborder="0" allowfullscreen></iframe>
        </section>
    </main>
</body>
</html>/* Element Selector */
body {
    font-family: Arial, sans-serif;
    background-color: #f4f6f9;
    color: #333333;
    margin: 0;
    padding: 20px;
}

/* ID Selector */
#main-header {
    text-align: center;
    margin-bottom: 30px;
}

#main-header h1 {
    color: #2c3e50;
    font-size: 2.5rem;
    margin-bottom: 5px;
}

.header-content {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 15px;
}

.logo {
    border-radius: 50%;
}

/* Class Selector */
.subtitle {
    color: #7f8c8d;
    font-size: 1.1rem;
}

.card {
    background-color: #ffffff;
    border-radius: 8px;
    padding: 20px;
    margin: 20px auto;
    max-width: 600px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
}

.input-group {
    margin-bottom: 15px;
}

.input-group label {
    display: block;
    margin-bottom: 5px;
    font-weight: bold;
    color: #34495e;
}

/* Direct Child Selector & Negation Pseudo-class */
#add-expense-section > form input:not([type="submit"]), 
#add-expense-section > form select {
    width: 100%;
    padding: 10px;
    border: 1px solid #bdc3c7;
    border-radius: 4px;
    box-sizing: border-box;
}

/* Focus State Selector */
input:focus, select:focus {
    outline: none;
    border-color: #3498db;
    box-shadow: 0 0 5px rgba(52, 152, 219, 0.5);
}

.btn {
    background-color: #3498db;
    color: white;
    padding: 10px 15px;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-size: 1rem;
    width: 100%;
}

.btn:hover {
    background-color: #2980b9;
}

/* Table Styling */
.expense-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 10px;
}

.expense-table th, 
.expense-table td {
    padding: 12px;
    text-align: left;
    border-bottom: 1px solid #ddd;
}

.expense-table th {
    background-color: #34495e;
    color: white;
}

/* Descendant Selector & Position Pseudo-class */
.expenses-section tr:nth-child(even) {
    background-color: #f9f9f9;
}

/* Table Row Hover Effect */
.expenses-section tr:hover {
    background-color: #f1f5f9;
}

details {
    cursor: pointer;
    color: #2c3e50;
}

details summary {
    font-weight: bold;
}
